# Clerk — from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Supabase — local dev values printed by `supabase start`
# For deployed env, use the project URL + anon key from dashboard.supabase.com
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose in a NEXT_PUBLIC_ variable.
# Used by admin-only server actions (bulk imports, etc).
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API key for Bank Import PDF parsing.
# Get one for free at https://aistudio.google.com/apikey
GEMINI_API_KEY=
